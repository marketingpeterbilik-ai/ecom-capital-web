# Cloudflare Pages — hlavičky. Rýchlosť načítania je rankingový faktor (Core Web
# Vitals), takže cache statických assetov je súčasť SEO, nie len infraštruktúry.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Buildované assety majú hash v názve — môžu sa cachovať navždy.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

# Súbory pre crawlerov musia byť čerstvé, nie ročné.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600
