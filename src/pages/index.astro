---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import StickyCta from '../components/StickyCta.astro';
import Visual from '../components/Visual.astro';
import { getCollection } from 'astro:content';

const services = [
  { href: '/sluzby/ppc', label: 'Správa PPC kampaní' },
  { href: '/sluzby/meranie', label: 'Meranie & tracking' },
  { href: '/data', label: 'Dáta & BigQuery' },
  { href: '/sluzby/automatizacia', label: 'AI automatizácia' },
  { href: '/sluzby/audit', label: 'Audit & konzultácie' },
  { href: '/cookie-consent', label: 'Cookie lišta & Consent Mode v2' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('sk-SK', { year: 'numeric', month: 'numeric', day: 'numeric' });
---

<Base
  title="Správa PPC kampaní postavená na meraní | Ecom Capital"
  description="Kampane v Google a Meta Ads a meranie, na ktorom stoja: GA4, server-side tracking, BigQuery. Reklama aj dáta pod jednou strechou."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="reveal">
        <h1 class="h1">Správa PPC postavená na spoľahlivom meraní.</h1>
        <p class="lead lead--lg">
          Kampane v Google a Meta Ads a meranie, na ktorom stoja — GA4, server-side tracking, BigQuery.
          Reklama aj dáta <strong>pod jednou strechou.</strong>
        </p>
        <div class="btn-row">
          <a href="#book" class="btn btn--lime">Rezervovať konzultáciu →</a>
          <a href="/sluzby" class="btn btn--outline">Všetky služby</a>
        </div>
        <div class="hero-stats stagger reveal">
          <div class="hero-stat">
            <div class="v"><span class="count">10</span><em>+</em></div>
            <div class="l">EU trhov so živými kampaňami</div>
          </div>
          <div class="hero-stat">
            <div class="v"><span class="count">€5M</span><em>+</em></div>
            <div class="l">spravovaného spendu</div>
          </div>
          <div class="hero-stat">
            <div class="v"><span class="count">50</span><em>+</em></div>
            <div class="l">úspešných spoluprác</div>
          </div>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="shape shape--lime shape-a"></div>
        <div class="shape shape--lime shape-b"></div>
        <div class="hero-plane">
          <Visual tone="indigo" />
        </div>
        <div class="hero-card">
          <div class="tick"><i>✓</i><span>Meranie v cene správy</span></div>
          <div class="tick"><i>✓</i><span>Bez viazanosti</span></div>
          <div class="tick"><i>✓</i><span>Odpoveď do 48 hodín</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SLUŽBY (indigo) -->
  <section class="sec sec--indigo">
    <div class="shape shape--indigo-deep" style="right:-40px;top:-30px;width:110px;height:88px"></div>
    <div class="shape shape--indigo-deep" style="right:40px;top:60px;width:110px;height:88px"></div>
    <div class="shape shape--lime" style="left:-46px;bottom:96px;width:94px;height:76px"></div>
    <div class="shape shape--lime" style="left:14px;bottom:14px;width:94px;height:76px"></div>

    <div class="wrap on-top">
      <div class="sec-head--center reveal">
        <h2 class="h2">Od kampaní po dátový sklad.</h2>
        <p class="lead">
          Každá služba má vlastnú stránku s detailom. Fungujú samostatne aj ako celok — reklama, meranie aj dáta
          v jednom systéme.
        </p>
      </div>

      <div class="svc-list reveal stagger">
        {
          services.map((s, i) => (
            <a href={s.href} class="svc-row">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="nm">{s.label}</span>
              <span class="go" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head--split reveal">
        <div>
          <h2 class="h2">Od reklamy po rozhodnutie — jeden systém.</h2>
          <p class="lead">
            Reklama, meranie aj dáta sedia v jednom systéme a navzájom spolupracujú — namiesto skladania z viacerých
            dodávateľov.
          </p>
        </div>
        <div class="btn-row">
          <a href="#book" class="btn btn--lime">Rezervovať konzultáciu →</a>
          <a href="/kalkulacka" class="btn btn--outline">Spočítať cenu</a>
        </div>
      </div>

      <div class="grid grid-4 reveal stagger">
        <div class="pipe-card">
          <div class="pipe-mock">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="bar" style="width:72%"></div>
            <div class="bar" style="width:92%"></div>
            <div class="bar" style="width:58%"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar" style="width:44%"></div>
          </div>
          <div class="pipe-body">
            <div class="k">01 Zber</div>
            <div class="nm">Reklamy &amp; kanály</div>
            <div class="sb">Google, Meta, GA4, feedy, CRM</div>
          </div>
        </div>

        <div class="pipe-card">
          <div class="pipe-mock">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="bar bar--lime" style="width:66%"></div>
            <div class="bar" style="width:92%"></div>
            <div class="bar" style="width:58%"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar" style="width:44%"></div>
          </div>
          <div class="pipe-body">
            <div class="k">02 Meranie</div>
            <div class="nm">Tracking</div>
            <div class="sb">GA4 + server-side, CAPI, consent</div>
          </div>
        </div>

        <div class="pipe-card">
          <div class="pipe-mock">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="bar" style="width:60%"></div>
            <div class="bar" style="width:92%"></div>
            <div class="bar bar--indigo" style="width:58%"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar" style="width:44%"></div>
          </div>
          <div class="pipe-body">
            <div class="k">03 Sklad</div>
            <div class="nm">BigQuery</div>
            <div class="sb">Jeden zdroj pravdy pre všetky dáta</div>
          </div>
        </div>

        <div class="pipe-card">
          <div class="pipe-mock">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="bar" style="width:54%"></div>
            <div class="bar" style="width:92%"></div>
            <div class="bar" style="width:58%"></div>
            <div class="bar" style="width:80%"></div>
            <div class="bar bar--lime" style="width:44%"></div>
          </div>
          <div class="pipe-body">
            <div class="k">04 Rozhodnutie</div>
            <div class="nm">Reporting</div>
            <div class="sb">Looker Studio dashboardy</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="sec sec--mist">
    <div class="wrap">
      <div class="sec-head--center reveal">
        <h2 class="h2">Najprv meranie, potom rozpočty.</h2>
        <p class="lead">
          Spoľahlivé dáta sú podmienkou efektívneho míňania. Rozhodnutia vychádzajú z čísel naprieč kanálmi, nie
          z pohľadu jednej platformy.
        </p>
      </div>

      <div class="mission-wrap reveal">
        <div class="mission-visual">
          <Visual tone="indigo" />
        </div>
        <div class="mission-badge">
          <div class="stats">
            <div>
              <div class="v"><span class="count">10</span><em>+</em></div>
              <div class="l">EU trhov</div>
            </div>
            <div>
              <div class="v"><span class="count">€5M</span><em>+</em></div>
              <div class="l">spravovaný spend</div>
            </div>
            <div>
              <div class="v"><span class="count">50</span><em>+</em></div>
              <div class="l">spoluprác</div>
            </div>
          </div>
        </div>
      </div>

      <div class="btn-row btn-row--center reveal" style="margin-top:66px">
        <a href="/sluzby" class="btn btn--lime">Pozrieť služby →</a>
        <a href="/proces" class="btn btn--outline">Ako prebieha spolupráca</a>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="sec sec--tight" style="padding-top:16px">
    <div class="wrap">
      <div class="ctaband reveal">
        <div class="shape shape--lime" style="right:-40px;top:-24px;width:104px;height:84px"></div>
        <div class="shape shape--lime" style="right:36px;top:64px;width:104px;height:84px"></div>
        <div class="ctaband-inner">
          <div style="max-width:600px">
            <h2 class="h2">Reklama aj dáta pod jednou strechou.</h2>
            <p>
              Jeden kontakt na kampane, tracking aj dátový sklad. Bez viazanosti — spolupráca beží z mesiaca na mesiac
              a účty aj dáta zostávajú vaše.
            </p>
          </div>
          <div class="btn-row">
            <a href="#book" class="btn btn--lime">Rezervovať konzultáciu →</a>
            <a href="/kalkulacka" class="btn btn--onindigo">Spočítať cenu</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Booking />

  <!-- BLOG (posledná sekcia stránky, pod rezervačným formulárom) -->
  {
    posts.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec-head--split reveal">
            <div>
              <h2 class="h2">Z praxe — PPC, meranie a dáta.</h2>
              <p class="lead">Praktické postrehy o reklame, trackingu a dátach. Po slovensky, z reálnych účtov.</p>
            </div>
            <div class="btn-row">
              <a href="/blog" class="btn btn--outline">
                Všetky články
              </a>
            </div>
          </div>

          <div class="grid grid-3 reveal stagger">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`} class="post-card">
                <Visual tone="mist" />
                <div class="body">
                  <div class="post-meta">
                    {post.data.tags.length ? `${post.data.tags[0]} · ` : ''}
                    {fmt(post.data.pubDate)}
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="link-arrow">Čítať →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <StickyCta />
</Base>

<style>
  .mission-wrap {
    position: relative;
  }
</style>
