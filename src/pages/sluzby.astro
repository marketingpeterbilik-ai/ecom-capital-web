---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import StickyCta from '../components/StickyCta.astro';
import { ID, breadcrumbLd } from '../data/site';

const services = [
  {
    href: '/sluzby/ppc',
    title: 'Správa PPC kampaní',
    lead: 'Dlhodobá správa Google a Meta Ads vrátane merania a produktových feedov. Optimalizácia podľa zisku a marže, rozhodnutia overiteľné v dátach.',
    items: [
      'Search, Shopping, Performance Max',
      'Meta: Advantage+, retargeting, kreatívy',
      'Produktové feedy a Merchant Center',
      'Týždenná optimalizácia, mesačný report',
    ],
    cta: 'Detail služby →',
  },
  {
    href: '/sluzby/meranie',
    title: 'Meranie & tracking',
    lead: 'Meranie, ktoré obstojí voči iOS, blokovačom aj cookieless prostrediu — a posiela čisté konverzie do Google aj Meta.',
    items: ['GA4 implementácia a audit', 'Server-side tracking (sGTM)', 'Meta CAPI & enhanced conversions'],
    cta: 'Detail služby →',
  },
  {
    href: '/data',
    title: 'Dáta & BigQuery',
    lead: 'Marketingové dáta z viacerých zdrojov v jednom sklade. Blended ROAS, CAC, LTV a marža — nezávisle od atribúcie platforiem.',
    items: ['Centralizovaný dátový sklad', 'Looker Studio dashboardy', 'Automatizované reporty'],
    cta: 'Detail služby →',
  },
  {
    href: '/sluzby/automatizacia',
    title: 'AI automatizácia',
    lead: 'Rutinné firemné procesy preberá AI a automatizácie na mieru — od zákazníckej podpory po back-office.',
    items: ['AI agenti a asistenti', 'Prepojenie systémov (CRM, e-shop, sklad)', 'Návrh, nasadenie aj správa'],
    cta: 'Detail služby →',
  },
  {
    href: '/sluzby/audit',
    title: 'Audit & konzultácie',
    lead: 'Nezávislé posúdenie účtov, merania a stratégie. Výstupom je zoznam krokov zoradený podľa dopadu na tržby.',
    items: ['Hĺbkový audit Google + Meta', 'Audit trackingu a dátového toku', 'Akčný plán a priority'],
    cta: 'Detail služby →',
  },
  {
    href: '/cookie-consent',
    title: 'Cookie lišta & Consent Mode v2',
    lead: 'Súlad s GDPR a podmienkami Googlu, ktoré platia od marca 2024. Nasadenie je otázka dní.',
    items: [
      'Nasadenie CMP certifikovanej Googlom',
      'Consent Mode v2 cez GTM aj server-side',
      'Test oboch scenárov + dokumentácia',
    ],
    cta: 'Detail služby a bezplatná kontrola webu →',
  },
];

// Rozcestník ako ItemList — vyhľadávač aj jazykový model si z jednej stránky
// prečíta celé portfólio služieb aj s odkazmi na detaily.
const jsonLd = [
  {
    '@type': 'ItemList',
    '@id': new URL('/sluzby', Astro.site).href + '#services',
    name: 'Služby Ecom Capital',
    numberOfItems: services.length,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        '@id': new URL(s.href, Astro.site).href + '#service',
        name: s.title,
        description: s.lead,
        url: new URL(s.href, Astro.site).href,
        provider: { '@id': ID.org(Astro.site) },
      },
    })),
  },
  breadcrumbLd(Astro.site, [
    { name: 'Domov', href: '/' },
    { name: 'Služby', href: '/sluzby' },
  ]),
];
---

<Base
  title="Služby — PPC, meranie a dáta pre e-shopy | Ecom Capital"
  description="Správa PPC kampaní, meranie a tracking, dáta a BigQuery, AI automatizácia, audit a cookie lišta s Consent Mode v2. Každá služba s vlastnou stránkou."
  pageType="CollectionPage"
  jsonLd={jsonLd}
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow reveal">Služby</span>
      <h1 class="h1 reveal">Reklama a meranie z jednej ruky.</h1>
      <p class="lead lead--lg reveal">
        Jadrom je dlhodobá správa kampaní postavená na spoľahlivom meraní. K nej služby, ktoré ju robia presnejšou —
        a jednorazové projekty, ktorými spolupráca zvykne začínať.
      </p>
      <div class="phero-ticks reveal">
        <div class="tick"><i>✓</i><span>Meranie v cene správy</span></div>
        <div class="tick"><i>✓</i><span>Bez viazanosti</span></div>
        <div class="tick"><i>✓</i><span>Jeden kontakt na reklamu aj dáta</span></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid-2 reveal stagger">
        {
          services.map((s) => (
            <div class="card card--shadow card--flex card--hover svc-card">
              <div class="h3">{s.title}</div>
              <p>{s.lead}</p>
              <ul class="card-list">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <a href={s.href} class="link-arrow">
                {s.cta}
              </a>
            </div>
          ))
        }
      </div>

      <div class="callout reveal" style="margin-top:28px">
        Spolupráca je bez viazanosti — dá sa ukončiť kedykoľvek, beží z mesiaca na mesiac. Účty, prístupy aj dáta
        zostávajú vaše. Priebeh spolupráce je popísaný na stránke <a href="/proces">Proces</a>.
      </div>
    </div>
  </section>

  <section class="sec sec--mist">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:44px">
        <span class="eyebrow">Vhodnosť spolupráce</span>
        <h2 class="h2" style="margin-top:16px">Pre koho je to vhodné — a pre koho menej.</h2>
      </div>
      <div class="grid grid-2">
        <div class="card card--shadow reveal">
          <div class="h3" style="margin-bottom:20px">Vhodné, ak…</div>
          <div style="display:flex;flex-direction:column;gap:13px">
            <div class="muted">firma má e-shop alebo B2B a reklama je dôležitý kanál</div>
            <div class="muted">cieľom je rozumieť dátam a rozhodovať sa podľa nich</div>
            <div class="muted">hľadá sa dlhodobý partner, nie najlacnejší dodávateľ</div>
            <div class="muted">preferuje sa priama komunikácia a jeden kontakt</div>
          </div>
        </div>
        <div class="card card--shadow reveal">
          <div class="h3" style="margin-bottom:20px">Menej vhodné, ak…</div>
          <div style="display:flex;flex-direction:column;gap:13px">
            <div class="muted">očakávaním je rýchly výsledok bez investície do merania</div>
            <div class="muted">záujmom sú len „najlacnejšie kliky“ bez ohľadu na výsledok</div>
            <div class="muted">nie je priestor meniť tracking ani dáta</div>
            <div class="muted">potrebný je veľký brandový tím namiesto výkonu</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--indigo sec--tight">
    <div class="wrap on-top">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap">
        <div class="reveal">
          <span class="eyebrow">Konzultácia · 15 min · online</span>
          <h2 class="h2" style="margin-top:16px;max-width:18ch">Krátky hovor o vašom účte a meraní.</h2>
        </div>
        <div class="btn-row reveal" style="flex-direction:column">
          <a href="#book" class="btn btn--lime btn--lg">Rezervovať termín →</a>
          <a href="/kalkulacka" class="btn btn--onindigo">Alebo spočítať cenu →</a>
        </div>
      </div>
    </div>
  </section>

  <Booking />
  <StickyCta />
</Base>
