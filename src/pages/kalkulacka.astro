---
import Base from '../layouts/Base.astro';
---

<Base
  title="Kalkulačka ceny | Ecom Capital"
  description="Orientačná cena správy PPC. Vyberte platformy, rozpočet a doplnkové služby a uvidíte odhad mesačnej ceny. Presná ponuka po konzultácii."
>
  <section class="phero" style="padding-bottom:48px">
    <div class="wrap">
      <span class="eyebrow reveal">Kalkulačka ceny</span>
      <h1 class="h1 reveal">Orientačná cena správy.</h1>
      <p class="lead lead--lg reveal">
        Výber platforiem, rozpočtu a doplnkových služieb ukáže cenové rozpätie. Presná ponuka vzíde z konzultácie
        podľa stavu účtu a reálneho rozsahu.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="calc">
        <div class="calc-controls reveal">
          <div class="calc-card">
            <div class="clabel">Ktoré platformy riešiť?</div>
            <div class="chint">Jedna alebo viac. Každá platforma znamená ďalšiu správu navyše.</div>
            <div class="chips" id="platforms">
              <button type="button" class="chip pf" data-h="8" aria-pressed="true">Google Ads</button>
              <button type="button" class="chip pf" data-h="7" aria-pressed="true">Meta Ads</button>
              <button type="button" class="chip pf" data-h="6" aria-pressed="false">TikTok Ads</button>
              <button type="button" class="chip pf" data-h="4" aria-pressed="false">Microsoft Ads</button>
            </div>
          </div>

          <div class="calc-card">
            <div class="slider-row">
              <label class="clabel" for="budget">Mesačný rozpočet na reklamu</label>
              <div class="slider-val" id="budgetVal" aria-hidden="true">3 000 €</div>
            </div>
            <div class="chint">Plánovaný mesačný výdaj na samotné reklamy (bez odmeny za správu).</div>
            <input type="range" id="budget" min="200" max="50000" step="100" value="3000" aria-label="Mesačný rozpočet na reklamu" />
            <div class="slider-ends"><span>200 €</span><span>50 000 €+</span></div>
          </div>

          <div class="calc-card">
            <div class="clabel">Počet trhov / jazykov</div>
            <div class="chint">Viac trhov znamená viac kampaní, prekladov a optimalizácie.</div>
            <div class="chips" id="markets">
              <button type="button" class="chip mk-btn" data-f="1" aria-pressed="true">1 trh</button>
              <button type="button" class="chip mk-btn" data-f="1.3" aria-pressed="false">2–3 trhy</button>
              <button type="button" class="chip mk-btn" data-f="1.6" aria-pressed="false">4+ trhov</button>
            </div>
          </div>

          <div class="calc-card">
            <div class="clabel">Doplnkové služby</div>
            <div class="chint">
              Voliteľné. Tracking, dáta a feedy majú jednorazové nastavenie a menšiu mesačnú údržbu.
            </div>
            <div class="chips--grid" id="addons">
              <button type="button" class="chip ad" data-m="1" data-s="12" aria-pressed="false">Tracking &amp; meranie</button>
              <button type="button" class="chip ad" data-m="4" data-s="20" aria-pressed="false">Dáta &amp; BigQuery</button>
              <button type="button" class="chip ad" data-m="2" data-s="8" aria-pressed="false">Produktové feedy</button>
              <button type="button" class="chip ad" data-m="3" data-s="0" aria-pressed="false">Pravidelný reporting</button>
              <button type="button" class="chip ad" data-m="1" data-s="3.3" aria-pressed="false">Cookie lišta &amp; consent</button>
            </div>
          </div>
        </div>

        <div class="calc-result reveal">
          <span class="eyebrow">Orientačná cena správy</span>
          <div aria-live="polite">
            <div class="price" id="rMonthly">…</div>
            <div class="pnote" id="rRange">vyberte aspoň jednu platformu</div>
          </div>

          <hr />

          <div class="calc-row">
            <span>Jednorazové nastavenie</span><b id="rSetup">—</b>
          </div>
          <div class="calc-row">
            <span>Reklamný rozpočet</span><b id="rBudget">3 000 €</b>
          </div>

          <p class="disclaimer">
            Orientačný odhad, nie záväzná ponuka. Presná cena závisí od stavu účtu a rozsahu práce — dohodne sa na
            konzultácii.
          </p>
          <a href="/kontakt" class="btn btn--lime btn--block">Vyžiadať presnú ponuku →</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const RATE = 30,
    FLOOR = 150;
  const elBudget = document.getElementById('budget') as HTMLInputElement | null;
  const elBudgetVal = document.getElementById('budgetVal');

  function fmtEur(v: number) {
    return Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' €';
  }
  function roundTo(v: number, s: number) {
    return Math.round(v / s) * s;
  }
  function budgetFactor(v: number) {
    if (v < 1000) return 0.8;
    if (v < 5000) return 1;
    if (v < 15000) return 1.3;
    if (v < 30000) return 1.6;
    return 2;
  }

  function recompute() {
    if (!elBudget || !elBudgetVal) return;
    const budget = parseInt(elBudget.value, 10);
    const budgetLabel = budget >= 50000 ? '50 000 €+' : fmtEur(budget);
    elBudgetVal.textContent = budgetLabel;
    document.getElementById('rBudget')!.textContent = budgetLabel;

    let platH = 0;
    let platCount = 0;
    document.querySelectorAll<HTMLElement>('#platforms .pf[aria-pressed="true"]').forEach((b) => {
      platH += parseFloat(b.dataset.h || '0');
      platCount++;
    });
    let mkF = 1;
    const amk = document.querySelector<HTMLElement>('#markets .mk-btn[aria-pressed="true"]');
    if (amk) mkF = parseFloat(amk.dataset.f || '1');
    let addMonth = 0,
      setupH = 0;
    document.querySelectorAll<HTMLElement>('#addons .ad[aria-pressed="true"]').forEach((b) => {
      addMonth += parseFloat(b.dataset.m || '0');
      setupH += parseFloat(b.dataset.s || '0');
    });

    const totalH = platH * budgetFactor(budget) * mkF + addMonth;
    const monthly = totalH > 0 ? Math.max(roundTo(totalH * RATE, 10), FLOOR) : 0;
    const setup = setupH > 0 ? roundTo(setupH * RATE, 50) : 0;

    const rMonthly = document.getElementById('rMonthly')!;
    const rRange = document.getElementById('rRange')!;
    if (monthly > 0) {
      const lo = roundTo(monthly * 0.85, 50),
        hi = roundTo(monthly * 1.15, 50);
      rMonthly.textContent = fmtEur(lo) + ' – ' + fmtEur(hi);
      rRange.textContent = platCount
        ? `mesačne za správu ${platCount === 1 ? '1 platformy' : platCount + ' platforiem'}`
        : 'mesačne, podľa zvoleného rozsahu';
    } else {
      rMonthly.textContent = '…';
      rRange.textContent = 'vyberte aspoň jednu platformu alebo službu';
    }

    document.getElementById('rSetup')!.textContent = setup > 0 ? '≈ ' + fmtEur(setup) : '—';
  }

  // prepínače (platformy + doplnky)
  document.querySelectorAll<HTMLElement>('#platforms .pf, #addons .ad').forEach((b) => {
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      recompute();
    });
  });

  // trhy — výber jednej možnosti
  document.querySelectorAll<HTMLElement>('#markets .mk-btn').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#markets .mk-btn').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      recompute();
    });
  });

  elBudget?.addEventListener('input', recompute);
  recompute();
</script>
