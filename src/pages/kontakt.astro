---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
---

<Base
  title="Kontakt | Ecom Capital"
  description="Nezáväzná konzultácia: krátky hovor o stave účtu a merania. Termín priamo v kalendári, alebo e-mailom na peter@ecomcapital.sk."
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow reveal">Kontakt</span>
      <h1 class="h1 reveal">Nezáväzná konzultácia.</h1>
      <p class="lead lead--lg reveal" style="margin-bottom:44px">
        Krátky hovor o stave účtu a merania. Termín sa dá rezervovať priamo v kalendári nižšie.
      </p>

      <div class="info-grid reveal stagger">
        <div class="info-cell">
          <div class="l">E-mail</div>
          <div class="v"><a href="mailto:peter@ecomcapital.sk">peter@ecomcapital.sk</a></div>
        </div>
        <div class="info-cell">
          <div class="l">Lokalita</div>
          <div class="v">Bratislava, Slovensko</div>
        </div>
        <div class="info-cell">
          <div class="l">Záber</div>
          <div class="v">PPC · Meranie · Dáta &amp; BigQuery</div>
        </div>
        <div class="info-cell">
          <div class="l">Spolupráca</div>
          <div class="v">Jednorazové projekty aj dlhodobá správa</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--tight" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid-2 reveal" style="align-items:start">
        <div>
          <span class="eyebrow">Konzultácia · 30 min · online</span>
          <h2 class="h2" style="margin:16px 0 20px">Čo na hovore preberieme.</h2>
          <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:28px">
            <div class="muted"><strong style="color:var(--ink)">Stav účtu a merania</strong> — čo funguje a čo nie.</div>
            <div class="muted"><strong style="color:var(--ink)">Priority</strong> — čo má zmysel riešiť ako prvé.</div>
            <div class="muted"><strong style="color:var(--ink)">Ďalší postup</strong> — či a ako dáva zmysel pokračovať.</div>
          </div>
        </div>
        <div class="note-box">
          <p>
            Pre orientačnú predstavu o cene ešte pred hovorom slúži <a href="/kalkulacka">kalkulačka</a>.
          </p>
          <p>Odpoveď na e-mail príde do 48 hodín.</p>
          <p>Radšej e-mail? Napíšte na <a href="mailto:peter@ecomcapital.sk">peter@ecomcapital.sk</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Booking eyebrow="Rezervácia termínu" title="Vyberte si čas, ktorý vám sedí." />
</Base>
