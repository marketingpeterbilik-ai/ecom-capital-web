---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { AUTHOR, ID, breadcrumbLd, faqLd as buildFaqLd } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('sk-SK', { year: 'numeric', month: 'long', day: 'numeric' });

const url = new URL(`/blog/${post.id}`, Astro.site).href;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

// Article schema — čistá, strojovo čitateľná fakticita pre AI vyhľadávače aj Google.
// Autor je konkrétny človek: bez identifikovateľného autora nemá odborný text v AI odpovediach váhu.
const articleLd = {
  '@type': 'BlogPosting',
  '@id': url + '#article',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: 'sk-SK',
  datePublished: published,
  dateModified: modified,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  author: { '@id': ID.person(Astro.site) },
  publisher: { '@id': ID.org(Astro.site) },
  isPartOf: { '@id': ID.website(Astro.site) },
  image: {
    '@type': 'ImageObject',
    url: new URL('/og.png', Astro.site).href,
    width: 1200,
    height: 630,
  },
};

const crumbLd = breadcrumbLd(Astro.site, [
  { name: 'Domov', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.data.title, href: `/blog/${post.id}` },
]);

// FAQ schema — priamo citovateľné otázky a odpovede, ktoré AI odpovede radi preberajú.
const jsonLd = [
  articleLd,
  crumbLd,
  ...(post.data.faq?.length ? [buildFaqLd(post.data.faq)] : []),
];
---

<Base
  title={`${post.data.title} | Ecom Capital`}
  description={post.data.description}
  ogType="article"
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={jsonLd}
>
  <section class="phero">
    <div class="wrap article">
      <a href="/blog" class="link-arrow reveal">← Späť na blog</a>
      <div class="post-meta reveal" style="margin-top:18px">
        <a href={AUTHOR.path} rel="author">{AUTHOR.name}</a> · {fmt(post.data.pubDate)}
        {post.data.tags.length ? ` · ${post.data.tags.join(' · ')}` : ''}
      </div>
      <h1 class="reveal" style="margin-top:10px">{post.data.title}</h1>
      <p class="lead lead--lg reveal" style="margin-top:16px">{post.data.description}</p>
    </div>
  </section>

  <section class="sec" style="padding-top:8px">
    <div class="wrap article">
      <div class="prose reveal">
        <Content />
      </div>

      <div class="author-box reveal">
        <div>
          <div class="author-box__name">{AUTHOR.name}</div>
          <p>
            {AUTHOR.jobTitle} z Bratislavy. Spravuje PPC kampane v Google a Meta Ads a stavia meranie,
            na ktorom stoja — GA4, server-side tracking a dátové sklady v BigQuery.
            <a href={AUTHOR.path}>Viac o mne →</a>
          </p>
        </div>
      </div>

      {post.data.faq?.length ? (
        <div class="prose reveal" style="margin-top:8px">
          <h2>Časté otázky</h2>
          {post.data.faq.map((f) => (
            <>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </>
          ))}
        </div>
      ) : null}
    </div>
  </section>

  <section class="sec sec--tight">
    <div class="wrap">
      <div class="ctaband reveal">
        <div class="shape shape--lime" style="right:-40px;top:-24px;width:104px;height:84px"></div>
        <div class="shape shape--lime" style="right:36px;top:64px;width:104px;height:84px"></div>
        <div class="ctaband-inner">
          <div style="max-width:600px">
            <h2 class="h2">Riešite niečo z článku na vlastnom účte?</h2>
            <p>Krátky hovor o stave účtu a merania — nezáväzne, 15 minút online.</p>
          </div>
          <div class="btn-row">
            <a href="/kontakt" class="btn btn--lime">Rezervovať konzultáciu →</a>
            <a href="/blog" class="btn btn--onindigo">Ďalšie články</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
