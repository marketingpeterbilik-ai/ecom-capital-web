---
import Base from '../../layouts/Base.astro';
import Visual from '../../components/Visual.astro';
import { getCollection } from 'astro:content';
import { ID, breadcrumbLd } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('sk-SK', { year: 'numeric', month: 'long', day: 'numeric' });

// Blog ako entita + zoznam článkov. Vyhľadávač tak z jednej stránky vidí celý
// archív aj s dátumami, bez toho, aby musel prejsť každý článok zvlášť.
const blogUrl = new URL('/blog', Astro.site).href;
const blogLd = {
  '@type': 'Blog',
  '@id': blogUrl + '#blog',
  url: blogUrl,
  name: 'Blog — Ecom Capital',
  description:
    'Praktické články o PPC, meraní, trackingu a dátach v BigQuery. Z reálnej praxe, po slovensky.',
  inLanguage: 'sk-SK',
  publisher: { '@id': ID.org(Astro.site) },
  author: { '@id': ID.person(Astro.site) },
  isPartOf: { '@id': ID.website(Astro.site) },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    '@id': new URL(`/blog/${p.id}`, Astro.site).href + '#article',
    headline: p.data.title,
    description: p.data.description,
    url: new URL(`/blog/${p.id}`, Astro.site).href,
    datePublished: p.data.pubDate.toISOString(),
    dateModified: (p.data.updatedDate ?? p.data.pubDate).toISOString(),
    author: { '@id': ID.person(Astro.site) },
  })),
};

const jsonLd = [
  blogLd,
  breadcrumbLd(Astro.site, [
    { name: 'Domov', href: '/' },
    { name: 'Blog', href: '/blog' },
  ]),
];
---

<Base
  title="Blog — PPC, meranie a dáta z praxe | Ecom Capital"
  description="Praktické články o PPC, meraní, trackingu a dátach v BigQuery. Z reálnej praxe, po slovensky, bez omáčky."
  pageType="CollectionPage"
  dateModified={(posts[0]?.data.updatedDate ?? posts[0]?.data.pubDate)?.toISOString()}
  jsonLd={jsonLd}
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow reveal">Blog</span>
      <h1 class="h1 reveal">Z praxe — PPC, meranie a dáta.</h1>
      <p class="lead lead--lg reveal">
        Praktické postrehy o reklame, trackingu a dátach. Po slovensky, z reálnych účtov.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="lead reveal">Čoskoro tu pribudnú prvé články.</p>
        ) : (
          <div class="post-list">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`} class="post-row reveal">
                <Visual tone="tint" />
                <div class="body">
                  <div class="post-meta">
                    {fmt(post.data.pubDate)}
                    {post.data.tags.length ? ` · ${post.data.tags.join(' · ')}` : ''}
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="link-arrow">Čítať →</span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
