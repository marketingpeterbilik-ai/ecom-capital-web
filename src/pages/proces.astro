---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
---

<Base
  title="Proces | Ecom Capital"
  description="Jasný päťkrokový postup od auditu cez architektúru a implementáciu po optimalizáciu a reporting. Vopred definovaný priebeh spolupráce."
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow reveal">Proces</span>
      <h1 class="h1 reveal">Jasne definovaný postup.</h1>
      <p class="lead lead--lg reveal">
        Päť krokov od prvého hovoru po pravidelný rast. Priebeh spolupráce je známy vopred.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="steps">
        <div class="step reveal">
          <div class="num">01</div>
          <div>
            <h3>Audit &amp; analýza</h3>
            <p>
              Zoznámenie s biznisom, cieľmi a maržami, posúdenie reklamných účtov aj stavu merania. Identifikácia
              toho, kde sa míňa neefektívne a kde chýbajú dáta.
            </p>
          </div>
        </div>
        <div class="step reveal">
          <div class="num">02</div>
          <div>
            <h3>Architektúra</h3>
            <p>
              Návrh dátového toku a plánu meraní, definícia KPI a metrík, ktoré sa budú reálne sledovať a na ktorých
              budú založené rozhodnutia.
            </p>
          </div>
        </div>
        <div class="step reveal">
          <div class="num">03</div>
          <div>
            <h3>Implementácia</h3>
            <p>
              Nastavenie trackingu a dátových pipeline, vybudovanie alebo prestavba kampaní a príprava dashboardov
              v Looker Studio.
            </p>
          </div>
        </div>
        <div class="step reveal">
          <div class="num">04</div>
          <div>
            <h3>Optimalizácia</h3>
            <p>
              Týždenná správa a ladenie výkonu: negatíva, bidy, kreatívy, rozpočty. Účet sa upravuje priebežne, nie
              raz za kvartál.
            </p>
          </div>
        </div>
        <div class="step reveal">
          <div class="num">05</div>
          <div>
            <h3>Reporting &amp; rast</h3>
            <p>
              Pravidelný reporting v slovenčine, spoločné rozhodnutia a škálovanie toho, čo funguje. Dáta určujú smer
              rastu.
            </p>
          </div>
        </div>
      </div>

      <div class="callout reveal" style="margin-top:32px">
        Spolupráca môže prebiehať jednorazovo (audit, setup trackingu, dátový sklad) alebo dlhodobo (kompletná správa
        a rast). <a href="/kalkulacka">Spočítať orientačnú cenu →</a>
      </div>
    </div>
  </section>

  <section class="sec sec--mist">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:44px">
        <span class="eyebrow">Prístup</span>
        <h2 class="h2" style="margin:16px 0 14px">Systematicky, merateľne, bez príkras.</h2>
        <p class="lead">
          Práca stojí na štandardizovanom systéme pre optimalizáciu a reporting. Vďaka tomu prebieha konzistentne
          a efektívne, s dôrazom na výsledok.
        </p>
      </div>
      <div class="grid grid-3 reveal stagger">
        <div class="card card--hover">
          <div class="h3">Opakovateľné procesy</div>
          <p>Štandardizované postupy a automatizácia namiesto ad-hoc práce pri každom účte.</p>
        </div>
        <div class="card card--hover">
          <div class="h3">Celý stack pod jednou strechou</div>
          <p>Merchant Center, feedy, CAPI, GA4 aj BigQuery bez skladania z viacerých dodávateľov.</p>
        </div>
        <div class="card card--hover">
          <div class="h3">Zrozumiteľný reporting</div>
          <p>Čo sa stalo, prečo a čo ďalej. V slovenčine, stručne, bez desiatok zbytočných grafov.</p>
        </div>
      </div>
    </div>
  </section>

  <Booking />
</Base>
