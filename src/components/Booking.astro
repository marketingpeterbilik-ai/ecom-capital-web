---
// Indigová konzultačná sekcia s bielym panelom: vľavo body hovoru, vpravo Cal.com.
import CalEmbed from './CalEmbed.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  items?: { b: string; t: string }[];
}

const {
  eyebrow = 'Konzultácia · 15 min · online',
  title = 'Krátky hovor o vašom účte a meraní.',
  lead = 'Nezáväzne, 15 minút online. Odpoveď na e-mail príde do 48 hodín.',
  items = [
    { b: 'Stav účtu a merania', t: ' — čo funguje a čo nie.' },
    { b: 'Priority', t: ' — čo má zmysel riešiť ako prvé.' },
    { b: 'Ďalší postup', t: ' — či a ako dáva zmysel pokračovať.' },
  ],
} = Astro.props;
---

<section class="sec sec--indigo sec--tight" id="book">
  <div class="shape shape--lime" style="left:-46px;bottom:80px;width:94px;height:76px"></div>
  <div class="shape shape--lime" style="left:14px;bottom:-2px;width:94px;height:76px"></div>

  <div class="wrap on-top">
    <div class="sec-head--center reveal">
      <h2 class="h2">{title}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class="book-panel panel-light reveal">
      <div class="book-side">
        <span class="eyebrow">{eyebrow}</span>
        <ul class="check-list">
          {
            items.map((i) => (
              <li>
                <span class="ic">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#17171B"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 13l5 5 9-11" />
                  </svg>
                </span>
                <span>
                  <strong>{i.b}</strong>
                  {i.t}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="book-mail">
          Radšej e-mail? <a href="mailto:info@ecomcapital.eu">info@ecomcapital.eu</a>
        </p>
      </div>

      <div class="book-cal">
        <CalEmbed height="440px" noscriptText="Pre rezerváciu termínu zapnite JavaScript, alebo napíšte priamo na" />
      </div>
    </div>
  </div>
</section>

<style>
  .book-panel {
    background: var(--paper);
    border-radius: 22px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    color: var(--ink);
    max-width: 1000px;
    margin: 0 auto;
  }
  .book-side {
    padding: 36px 34px;
    background: var(--mist);
  }
  .book-side .check-list {
    margin-top: 24px;
  }
  .book-side .check-list li {
    color: var(--slate);
  }
  .book-mail {
    margin-top: 28px;
    font-size: 0.92rem;
    color: var(--slate);
  }
  .book-mail a {
    font-weight: 700;
  }
  .book-cal {
    padding: 10px;
  }
  @media (max-width: 980px) {
    .book-panel {
      grid-template-columns: 1fr;
    }
    .book-side {
      padding: 32px 26px;
    }
  }
</style>
