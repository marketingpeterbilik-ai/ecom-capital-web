---
interface Props {
  calLink?: string;
  elementId?: string;
  height?: string;
  noscriptText?: string;
  /** Detaily typu udalosti (názov, dĺžka, zóna) — na webe ich duplikuje text vedľa embedu. */
  showEventDetails?: boolean;
  /** Zmenšenie embedu, aby kalendár nezaberal celú obrazovku. */
  scale?: number;
}

const {
  calLink = 'ecom-capital/15min',
  elementId = 'my-cal-inline',
  height = '460px',
  noscriptText = 'To book a slot, enable JavaScript, or write directly to',
  showEventDetails = false,
  scale = 0.85,
} = Astro.props;
---

{/* min-height, nie height — Cal si iframe po načítaní zväčší podľa obsahu
    a s pevnou výškou by sa kalendár orezal a scrolloval vnútri panela.
    zoom zmenšuje celý embed vrátane výšky, ktorú si Cal nastaví sám. */}
<div class="cal-embed" id={elementId} style={`width:100%;min-height:${height};zoom:${scale}`}></div>
<noscript>
  <p style="color:var(--slate); margin-top:12px"
    >{noscriptText} <a href="mailto:peter@ecomcapital.sk" style="font-weight:700">peter@ecomcapital.sk</a>.</p
  >
</noscript>

<script is:inline define:vars={{ CAL_LINK: calLink, ELEMENT_ID: elementId, SHOW_DETAILS: showEventDetails }}>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', { origin: 'https://app.cal.com' });
  Cal('inline', {
    elementOrSelector: '#' + ELEMENT_ID,
    calLink: CAL_LINK,
    layout: 'month_view',
    config: { theme: 'light' },
  });
  Cal('ui', {
    // Web je svetlý dizajn a embed sedí v bielom paneli — tmavú tému
    // zdedenú zo systému návštevníka preto vypíname natvrdo.
    theme: 'light',
    cssVarsPerTheme: { light: { 'cal-brand': '#3826F3' } },
    // Názov, dĺžka a spôsob stretnutia sú uvedené vedľa embedu — v kalendári
    // by sa opakovali a zbytočne ho predlžovali.
    hideEventTypeDetails: !SHOW_DETAILS,
    layout: 'month_view',
  });
</script>
