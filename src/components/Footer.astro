        <a href="mailto:peter@ecomcapital.sk">peter@ecomcapital.sk</a>
      </div>

      <div class="foot-col">
        <h5>Právne</h5>
        <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
        <a href="/cookies">Cookies</a>
      </div>
    </div>

    <div class="foot-rule"></div>

    <div class="foot-bottom">
      <span>© {year} Ecom Capital s.r.o. · Bratislava, SK · IČO: 53419952</span>
      <span>Všetky práva vyhradené</span>
    </div>
  </div>
</footer>
